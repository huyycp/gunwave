  "fixed_sql": [
    {
      "name": "abilities",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"abilities\" (\"id\" TEXT NOT NULL, \"key\" TEXT NOT NULL UNIQUE, \"name\" TEXT NOT NULL, \"description\" TEXT NOT NULL, \"cooldown_ms\" INTEGER NOT NULL, \"duration_ms\" INTEGER NULL, \"parameters_json\" TEXT NOT NULL DEFAULT '{}', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "characters",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"characters\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"filename\" TEXT NOT NULL, \"price\" INTEGER NOT NULL CHECK(\"price\" >= 0), \"base_hp\" INTEGER NOT NULL, \"base_str\" INTEGER NOT NULL, \"base_vit\" INTEGER NOT NULL, \"base_agi\" INTEGER NOT NULL, \"ability_id\" TEXT NULL REFERENCES abilities (id) ON DELETE SET NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "stages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"stages\" (\"id\" TEXT NOT NULL, \"stage_order\" INTEGER NOT NULL UNIQUE, \"name\" TEXT NOT NULL, \"map_key\" TEXT NOT NULL, \"unlock_requirement_stage_id\" TEXT NULL REFERENCES stages (id) ON DELETE SET NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "monsters",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"monsters\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"filename\" TEXT NOT NULL, \"hp\" INTEGER NOT NULL, \"str\" INTEGER NOT NULL, \"vit\" INTEGER NOT NULL, \"agi\" INTEGER NOT NULL, \"score\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "stage_monsters",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"stage_monsters\" (\"stage_id\" TEXT NOT NULL REFERENCES stages (id) ON DELETE CASCADE, \"monster_id\" TEXT NOT NULL REFERENCES monsters (id) ON DELETE CASCADE, PRIMARY KEY (\"stage_id\", \"monster_id\"));"
        }
      ]
    },
    {
      "name": "stage_rounds",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"stage_rounds\" (\"id\" TEXT NOT NULL, \"stage_id\" TEXT NOT NULL REFERENCES stages (id) ON DELETE CASCADE, \"round_number\" INTEGER NOT NULL, \"is_boss\" INTEGER NOT NULL CHECK (\"is_boss\" IN (0, 1)), PRIMARY KEY (\"id\"), UNIQUE (\"stage_id\", \"round_number\"));"
        }
      ]
    },
    {
      "name": "round_encounters",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"round_encounters\" (\"round_id\" TEXT NOT NULL REFERENCES stage_rounds (id) ON DELETE CASCADE, \"encounter_order\" INTEGER NOT NULL, \"monster_id\" TEXT NOT NULL REFERENCES monsters (id) ON DELETE RESTRICT, \"spawn_marker\" TEXT NOT NULL, \"count\" INTEGER NOT NULL, PRIMARY KEY (\"round_id\", \"encounter_order\"));"
        }
      ]
    },
    {
      "name": "stage_rewards",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"stage_rewards\" (\"stage_id\" TEXT NOT NULL REFERENCES stages (id) ON DELETE CASCADE, \"reward_order\" INTEGER NOT NULL, \"type\" TEXT NOT NULL, \"amount\" INTEGER NOT NULL, PRIMARY KEY (\"stage_id\", \"reward_order\"));"
        }
      ]
    },
    {
      "name": "player_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"player_states\" (\"id\" INTEGER NOT NULL CHECK (id = 1), \"gold\" INTEGER NOT NULL CHECK(\"gold\" >= 0), \"status_points\" INTEGER NOT NULL CHECK(\"status_points\" >= 0), \"selected_hero_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "player_characters",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"player_characters\" (\"character_id\" TEXT NOT NULL REFERENCES characters (id) ON DELETE RESTRICT, \"hp\" INTEGER NOT NULL, \"str\" INTEGER NOT NULL, \"vit\" INTEGER NOT NULL, \"agi\" INTEGER NOT NULL, \"status_points\" INTEGER NOT NULL CHECK(\"status_points\" >= 0), \"acquired_at\" INTEGER NOT NULL, PRIMARY KEY (\"character_id\"));"
        }
      ]
    },
    {
      "name": "campaign_stage_clears",
