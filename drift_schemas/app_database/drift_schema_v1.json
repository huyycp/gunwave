        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"campaign_stage_clears\" (\"stage_id\" TEXT NOT NULL REFERENCES stages (id) ON DELETE RESTRICT, \"completed_at\" INTEGER NOT NULL, PRIMARY KEY (\"stage_id\"));"
        }
      ]
    },
